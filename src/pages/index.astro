<!doctype html>
<html lang="en">

  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Ayatallah (Aya) Elakhras · Computer Architecture Researcher</title>
    <meta
      name="description"
      content="Ayatallah (Aya) Elakhras is a Senior Researcher at Huawei Research Center in Zürich and an EPFL Ph.D. graduate working on computer architecture, high-level synthesis, and dataflow circuits."
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://ayaelakhras.github.io/" />

    <!-- Preview metadata for sharing this site on LinkedIn and other platforms. -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content="Ayatallah (Aya) Elakhras · Computer Architecture Researcher" />
    <meta property="og:description" content="Research in computer architecture, high-level synthesis, and dataflow circuits. Senior Researcher at Huawei Research Center in Zürich; Ph.D. from EPFL." />
    <meta property="og:url" content="https://ayaelakhras.github.io/" />
