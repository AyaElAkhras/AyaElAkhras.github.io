---
import '../styles/global.css';
import { execFileSync } from 'node:child_process';

// Automatically determine the last update date from Git.
// Fall back to the build date if Git information is unavailable.
let lastUpdated = new Date();

try {
  const gitDate = execFileSync('git', ['log', '-1', '--format=%cI'], {
    encoding: 'utf8'
  }).trim();

  if (gitDate) {
    const parsedDate = new Date(gitDate);

    if (!Number.isNaN(parsedDate.getTime())) {
      lastUpdated = parsedDate;
    }
  }
} catch {
  // Git information is unavailable; use the build date instead.
}

const formattedDate = lastUpdated.toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
});

