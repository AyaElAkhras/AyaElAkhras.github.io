      <!-- Research -->
      <section id="research">
        <div class="wrapper section-grid">
          <h2>Research</h2>
          <div class="items research-projects">
            <article class="item">
              <h3>Instruction-level parallelism in dataflow circuits</h3>
              <p class="muted">
                Exploiting <strong>control dependence</strong> to deliver data tokens earlier
                and enable more aggressive <strong>out-of-order execution</strong> in
                dynamically scheduled circuits generated from sequential programs.
              </p>
              <div class="research-papers" aria-label="Related publications">
                <span class="research-papers-label">Related papers</span>
                <a href={publications[5].url} target="_blank" rel="noopener noreferrer">FPL ’22 · Fast Token Delivery ↗</a>
                <a href={publications[3].url} target="_blank" rel="noopener noreferrer">FPGA ’24 · Survival of the Fastest ↗</a>
              </div>
            </article>

            <article class="item">
              <h3>Memory-level parallelism and access reordering</h3>
              <p class="muted">
                Designing lightweight interfaces to spatial load-store queues
                and custom memory-reordering circuits that expose
                <strong>memory-level parallelism</strong> without relying on conventional
                centralized load-store queues.
              </p>
              <div class="research-papers" aria-label="Related publications">
                <span class="research-papers-label">Related papers</span>
                <a href={publications[4].url} target="_blank" rel="noopener noreferrer">FPGA ’23 · Straight to the Queue ↗</a>
                <a href={publications[1].url} target="_blank" rel="noopener noreferrer">FPGA ’26 · Out with LSQs ↗</a>
              </div>
            </article>

            <article class="item">
              <h3>Fine-grained out-of-order execution</h3>
              <p class="muted">
                Introducing <strong>tagging mechanisms</strong> and circuit transformations
                that enable multiple independent execution contexts to progress
                simultaneously, bringing <strong>multithreading</strong> to dataflow circuits.
              </p>
              <div class="research-papers" aria-label="Related publications">
                <span class="research-papers-label">Related paper</span>
                <a href={publications[3].url} target="_blank" rel="noopener noreferrer">FPGA ’24 · Survival of the Fastest ↗</a>
              </div>
            </article>

            <article class="item">
              <h3>Formal verification of dataflow circuits</h3>
              <p class="muted">
                Collaborating with researchers at EPFL and ETH Zürich to establish
                the correctness of circuit transformations and out-of-order execution
                techniques through <strong>model checking</strong> and
                <strong>Lean-based formal proofs</strong>.
              </p>
              <div class="research-papers" aria-label="Related publications">
                <span class="research-papers-label">Related papers</span>
                <a href={publications[2].url} target="_blank" rel="noopener noreferrer">ASPLOS ’25 · ElasticMiter ↗</a>
                <a href={publications[0].url} target="_blank" rel="noopener noreferrer">ASPLOS ’26 · Graphiti ↗</a>
              </div>
            </article>
          </div>
