      .muted, .item-meta, .news-date { color: var(--portfolio-muted) !important; }
      a { color: var(--portfolio-link); }
      header, footer, .item, .news-row { border-color: var(--portfolio-border) !important; }
      .tab-panel[hidden] { display: none !important; }
      .portfolio-tabs { display: flex; gap: .3rem; flex-wrap: wrap; align-items: center; }
      .portfolio-tabs button, .theme-toggle {
        background: transparent; color: var(--portfolio-text); cursor: pointer;
        font: inherit; font-size: .88rem; border: 1px solid transparent;
        border-radius: 7px; padding: .5rem .65rem;
      }
      .portfolio-tabs button:hover, .theme-toggle:hover { background: var(--portfolio-hover); }
      .portfolio-tabs button[aria-selected="true"] {
        font-weight: 700; border-color: var(--portfolio-border);
        background: var(--portfolio-hover);
      }
      .portfolio-tabs button:focus-visible, .theme-toggle:focus-visible {
        outline: 2px solid var(--portfolio-link); outline-offset: 2px;
      }
      .theme-toggle { white-space: nowrap; border-color: var(--portfolio-border); }
      .nav { gap: .75rem; flex-wrap: wrap; }
      .nav .portfolio-tabs { flex: 1 1 350px; }
      .items > h3 { margin-top: 1.2rem; }
      .news-link, .tag, .links a { color: var(--portfolio-link) !important; border-color: var(--portfolio-border) !important; }
      .news-link:hover, .links a:hover { background: var(--portfolio-hover) !important; }
      .hero-copy { min-width: 0; }
      /* Align the photo with the top of the introduction rather than centering it. */
      .hero { align-items: flex-start !important; }
      .profile-photo { align-self: flex-start !important; margin-top: 0 !important; }
      .hero-copy .links { margin-top: .65rem; margin-bottom: 1.4rem; }
      .hero-copy .lead p { margin: 0 0 1rem; line-height: 1.7; }
      .research-highlights { list-style: disc; padding-left: 1.4rem; margin: .8rem 0 1.2rem; }
      .research-highlights li { margin-bottom: .65rem; line-height: 1.65; }
      :root[data-theme="dark"] .research-highlights { color: #d0d1d3; }
      .hero-copy h1 { font-size: clamp(1.35rem, 3.5vw, 2.25rem) !important; }
      @media (max-width: 650px) {
        .nav .brand { width: 100%; }
        .portfolio-tabs button { padding: .45rem .55rem; }
        .hero-copy h1 { white-space: normal !important; }
      }

      /* Continuous, scrollable page with anchor navigation. */
      html { scroll-behavior: smooth; scroll-padding-top: 5.5rem; }
      section[id] { scroll-margin-top: 5.5rem; }
      .tab-panel[hidden] { display: block !important; }
      .portfolio-tabs a {
        display: inline-flex; align-items: center; text-decoration: none;
        font: inherit; font-size: .88rem; padding: .5rem .65rem;
        border: 1px solid transparent; border-radius: 7px;
