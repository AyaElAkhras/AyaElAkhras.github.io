        text-underline-offset: 2px;
      }
      .research-papers a:hover { text-decoration-thickness: 2px; }

      /* Subtle architectural background: quiet grid + diffused color, no image assets. */
      :root {
        --site-glow-one: rgba(104, 150, 196, .13);
        --site-glow-two: rgba(163, 174, 207, .10);
        --site-grid: rgba(66, 92, 125, .035);
        --site-header-glass: rgba(255, 255, 255, .90);
      }
      :root[data-theme="dark"] {
        --site-glow-one: rgba(86, 121, 163, .16);
        --site-glow-two: rgba(132, 115, 149, .12);
        --site-grid: rgba(208, 215, 225, .035);
        --site-header-glass: rgba(24, 26, 29, .90);
      }
      body {
        background-color: var(--portfolio-bg) !important;
        background-image:
          radial-gradient(ellipse 75% 45% at 88% 3%, var(--site-glow-one), transparent 78%),
          radial-gradient(ellipse 65% 40% at 0% 53%, var(--site-glow-two), transparent 78%),
