        background-attachment: fixed;
      }
      /* Avoid opaque section backgrounds hiding the canvas. */
      main, main section, footer { background-color: transparent !important; }
      header {
        background-color: var(--site-header-glass) !important;
        -webkit-backdrop-filter: blur(14px);
        backdrop-filter: blur(14px);
      }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
    </style>
