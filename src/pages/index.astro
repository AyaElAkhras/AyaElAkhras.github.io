          "https://scholar.google.com/citations?user=6Jo1OrgAAAAJ&hl=en",
          "https://github.com/AyaElAkhras",
          "https://www.linkedin.com/in/aya-elakhras/"
        ]
      }
    </script>

    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('portfolio-theme');
        document.documentElement.dataset.theme = savedTheme === 'dark' || savedTheme === 'light'
          ? savedTheme
          : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
    <style>
      /* Self-contained tab and theme styling; no changes to global.css needed. */
      :root {
        color-scheme: light;
        --portfolio-bg: #fff;
        --portfolio-text: #20252d;
        --portfolio-muted: #5d6570;
        --portfolio-border: #dce1e6;
        --portfolio-hover: #f2f4f7;
        --portfolio-link: #205a91;
      }
      :root[data-theme="dark"] {
        color-scheme: dark;
        --portfolio-bg: #181a1d;
        --portfolio-text: #f0efed;
        --portfolio-muted: #bcbec2;
        --portfolio-border: #45474b;
        --portfolio-hover: #2a2c30;
        --portfolio-link: #d6dadd;
      }
      /* Warm, neutral dark mode; override any fixed colors in global.css. */
      :root[data-theme="dark"] .hero-copy .lead {
        color: #d0d1d3 !important;
        opacity: 1 !important;
      }
      :root[data-theme="dark"] .hero-copy .eyebrow {
