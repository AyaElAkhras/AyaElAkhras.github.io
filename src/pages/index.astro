      :root[data-theme="dark"] .portfolio-tabs a:focus-visible {
        color: #fff !important; background: #34363a !important;
      }
      /* Two-column introduction: photo is alongside and top-aligned with the name. */
      .hero { display: block !important; }
      .hero-copy {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 205px;
        column-gap: clamp(1rem, 3vw, 2rem);
        width: 100%;
        max-width: none;
        align-items: start;
      }
      .hero-copy > h1 { grid-column: 1; grid-row: 1; min-width: 0; }
      .hero-copy > .links { grid-column: 1; grid-row: 2; min-width: 0; }
      .hero-copy > .eyebrow { grid-column: 1; grid-row: 3; min-width: 0; }
      .hero-copy > .intro-row { grid-column: 1; grid-row: 4; min-width: 0; }
      .hero-copy > .profile-photo {
        grid-column: 2;
        grid-row: 1 / 5;
        justify-self: end;
        align-self: start !important;
        width: 205px !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
      }
      .hero-copy > .profile-photo img {
        display: block;
        width: 100% !important;
        height: auto !important;
        object-fit: contain;
      }
      .intro-row { display: block; }
      /* Match the introduction typography to the body text elsewhere on the page. */
      .intro-row .lead {
        min-width: 0;
        font-size: 1rem !important;
        line-height: 1.6;
      }
      .intro-row .lead p,
      .intro-row .lead li {
        font-size: inherit !important;
        line-height: 1.6;
      }
      /* Keep natural word spacing in the biography, even if global.css justifies text. */
      .hero-copy .intro-row .lead,
      .hero-copy .intro-row .lead p,
      .hero-copy .intro-row .lead li,
      .hero-copy .intro-row .lead strong,
      .hero-copy .intro-row .lead em {
        text-align: left !important;
        text-align-last: auto !important;
        word-spacing: normal !important;
        letter-spacing: normal !important;
        white-space: normal !important;
      }
      .hero-copy .intro-row .lead p,
      .hero-copy .intro-row .lead li {
        hyphens: none;
        overflow-wrap: normal;
        word-break: normal;
      }

      @media (max-width: 650px) {
        .hero-copy { grid-template-columns: minmax(0, 1fr) 130px; gap: 0 1rem; }
        .hero-copy > .profile-photo { width: 130px !important; }
      }
      @media (max-width: 440px) {
        .hero-copy { grid-template-columns: minmax(0, 1fr) 105px; column-gap: .75rem; }
        .hero-copy > .profile-photo { width: 105px !important; }
      }
      /* Compact publication citations under each research project. */
      .research-papers {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        column-gap: 1rem;
        row-gap: .35rem;
        margin-top: .55rem;
        font-size: .88rem;
        line-height: 1.55;
      }
      .research-papers-label {
        color: var(--portfolio-muted);
        font-weight: 600;
      }
      .research-papers a {
        color: var(--portfolio-link) !important;
